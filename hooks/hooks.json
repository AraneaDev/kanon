{
  "hooks": {
    "InstructionsLoaded": [
      { "hooks": [ { "type": "command", "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/record.sh\"", "timeout": 5 } ] }
    ],
    "ConfigChange": [
      { "hooks": [ { "type": "command", "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/record.sh\"", "timeout": 5 } ] }
    ],
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/record.sh\"", "timeout": 5 },
        { "type": "command", "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/session-start.sh\"", "timeout": 5 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/session-end.sh\"", "timeout": 5 } ] }
    ]
  }
}
